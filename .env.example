# Database - defaults to SQLite (zero config). Swap to Postgres URL for prod:
# postgresql://user:password@host:5432/regwatch
DATABASE_URL=sqlite:///./regwatch.db

# LLM Provider - Google Gemini (free tier, no card required)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Matching thresholds
SIMILARITY_THRESHOLD=0.55
RERANK_TOP_K=5
VERIFICATION_MIN_SCORE=3

# Auth
JWT_SECRET=change_this_to_a_random_secret_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Pipeline / prompt versioning
PROMPT_VERSION=v1
PIPELINE_VERSION=v1
